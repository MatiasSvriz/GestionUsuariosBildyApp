### =========================================
### BildyApp - REST Client tests
### =========================================

@baseUrl = http://localhost:3000/api/user
@json = application/json

### =========================================
### VARIABLES
### Rellena estos valores manualmente
### =========================================
@accessToken = ACCESS_TOKEN
@refreshToken = REFRESH_TOKEN
@verificationCode = CODIGO_MONGODB

### =========================================
### 0) Health check
### =========================================
GET http://localhost:3000/health

### =========================================
### 1) Registro de usuario
### =========================================
POST {{baseUrl}}/register
Content-Type: {{json}}

{
  "email": "matias.ejemplo@test.com",
  "password": "12345678"
}

### =========================================
### 2) Validación del email
### El código se obtiene de MongoDB
### =========================================
PUT {{baseUrl}}/validation
Content-Type: {{json}}
Authorization: Bearer {{accessToken}}

{
  "code": "{{verificationCode}}"
}

### =========================================
### 3) Login
### Copia aquí el nuevo accessToken y refreshToken
### =========================================
POST {{baseUrl}}/login
Content-Type: {{json}}

{
  "email": "matias.ejemplo@test.com",
  "password": "12345678"
}

### =========================================
### 4) Onboarding - Datos personales
### =========================================
PUT {{baseUrl}}/register
Content-Type: {{json}}
Authorization: Bearer {{accessToken}}

{
  "name": "Matias",
  "lastName": "Svriz",
  "nif": "12345678A"
}

### =========================================
### 5) Onboarding - Datos personales con dirección
### =========================================
PUT {{baseUrl}}/register
Content-Type: {{json}}
Authorization: Bearer {{accessToken}}

{
  "name": "Matias",
  "lastName": "Svriz",
  "nif": "12345678A",
  "address": {
    "street": "San Agustín",
    "number": "4",
    "postal": "24001",
    "city": "León",
    "province": "León"
  }
}

### =========================================
### 6A) Onboarding - Company normal
### =========================================
PATCH {{baseUrl}}/company
Content-Type: {{json}}
Authorization: Bearer {{accessToken}}

{
  "isFreelance": false,
  "name": "Bildy Company",
  "cif": "B12345678",
  "address": {
    "street": "Calle Mayor",
    "number": "12",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### =========================================
### 6B) Onboarding - Autónomo
### Usa el NIF y los datos del usuario
### =========================================
PATCH {{baseUrl}}/company
Content-Type: {{json}}
Authorization: Bearer {{accessToken}}

{
  "isFreelance": true
}

### =========================================
### 7) Subir logo de la compañía
### Cambia la ruta por una imagen real
### =========================================
PATCH {{baseUrl}}/logo
Authorization: Bearer {{accessToken}}

--boundary
Content-Disposition: form-data; name="logo"; filename="logo.jpeg"
Content-Type: image/jpeg

< ../uploads/logo.jpeg
--boundary--

### =========================================
### 8) Obtener usuario autenticado
### Debe traer company con populate y fullName
### =========================================
GET {{baseUrl}}
Authorization: Bearer {{accessToken}}

### =========================================
### 9) Refresh token
### Devuelve un nuevo accessToken
### =========================================
POST {{baseUrl}}/refresh
Content-Type: {{json}}

{
  "refreshToken": "{{refreshToken}}"
}

### =========================================
### 10) Logout
### Invalida el refresh token guardado
### =========================================
POST {{baseUrl}}/logout
Authorization: Bearer {{accessToken}}

### =========================================
### 11) Cambiar contraseña
### La nueva debe ser distinta a la actual
### =========================================
PUT {{baseUrl}}/password
Content-Type: {{json}}
Authorization: Bearer {{accessToken}}

{
  "currentPassword": "12345678",
  "newPassword": "87654321"
}

### =========================================
### 12) Login con la nueva contraseña
### =========================================
POST {{baseUrl}}/login
Content-Type: {{json}}

{
  "email": "matias.ejemplo@test.com",
  "password": "87654321"
}

### =========================================
### 13) Invitar compañero
### Requiere admin
### El invitado entra como guest y con la misma company
### =========================================
POST {{baseUrl}}/invite
Content-Type: {{json}}
Authorization: Bearer {{accessToken}}

{
  "email": "companero.demo@test.com",
  "password": "12345678",
  "name": "Ana",
  "lastName": "Lopez",
  "nif": "11111111A"
}

### =========================================
### 14) Login del invitado
### =========================================
POST {{baseUrl}}/login
Content-Type: {{json}}

{
  "email": "companero.demo@test.com",
  "password": "12345678"
}

### =========================================
### 15) Soft delete del usuario autenticado
### =========================================
DELETE {{baseUrl}}?soft=true
Authorization: Bearer {{accessToken}}

### =========================================
### 16) Hard delete del usuario autenticado
### =========================================
DELETE {{baseUrl}}
Authorization: Bearer {{accessToken}}