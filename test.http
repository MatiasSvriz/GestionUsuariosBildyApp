@baseUrl = http://localhost:3000
@json = application/json
@userPassword = TestPassword123!
@userNewPassword = TestPassword456!
@logoPath = ./logo.png
@signaturePath = ./firma.jpg

### 0) HEALTH
GET {{baseUrl}}/health


### 1) REGISTRO
# @name register
POST {{baseUrl}}/api/user/register
Content-Type: {{json}}

{
  "email": "matias.demo.test1@test.com",
  "password": "{{userPassword}}"
}


### 2) LOGIN
# @name login
POST {{baseUrl}}/api/user/login
Content-Type: {{json}}

{
  "email": "{{register.response.body.$.data.user.email}}",
  "password": "{{userPassword}}"
}


### 3) DATOS PERSONALES
PUT {{baseUrl}}/api/user/register
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "name": "Matias",
  "lastName": "Demo Tester",
  "nif": "12345678Z",
  "address": {
    "street": "Calle Falsa",
    "number": "123",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}


### 4) COMPANY
PATCH {{baseUrl}}/api/user/company
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "name": "Bildy Demo Company",
  "cif": "B{{$timestamp}}",
  "isFreelance": false,
  "address": {
    "street": "Avenida Empresa",
    "number": "22",
    "postal": "28002",
    "city": "Madrid",
    "province": "Madrid"
  }
}


### 5) GET USER
GET {{baseUrl}}/api/user
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 6) LOGO COMPANY
PATCH {{baseUrl}}/api/user/logo
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: multipart/form-data; boundary=LogoBoundary

--LogoBoundary
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

< {{logoPath}}
--LogoBoundary--


### 7) CREAR CLIENTE
# @name createClient
POST {{baseUrl}}/api/client
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "name": "Cliente Demo",
  "cif": "C{{$timestamp}}",
  "email": "cliente{{$timestamp}}@demo.com",
  "phone": "600123123",
  "address": {
    "street": "Calle Mayor",
    "number": "10",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}


### 8) LISTAR CLIENTES
GET {{baseUrl}}/api/client?page=1&limit=10&name=Cliente&sort=createdAt
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 9) OBTENER CLIENTE
GET {{baseUrl}}/api/client/{{createClient.response.body.$.data._id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 10) ACTUALIZAR CLIENTE
PUT {{baseUrl}}/api/client/{{createClient.response.body.$.data._id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "name": "Cliente Demo Actualizado",
  "cif": "{{createClient.response.body.$.data.cif}}",
  "email": "cliente.actualizado{{$timestamp}}@demo.com",
  "phone": "611111111",
  "address": {
    "street": "Calle Nueva",
    "number": "99",
    "postal": "28003",
    "city": "Madrid",
    "province": "Madrid"
  }
}


### 11) CREAR PROYECTO
# @name createProject
POST {{baseUrl}}/api/project
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "client": "{{createClient.response.body.$.data._id}}",
  "name": "Proyecto Reforma Local",
  "projectCode": "PR-{{$timestamp}}",
  "email": "obra{{$timestamp}}@demo.com",
  "notes": "Proyecto de prueba",
  "active": true,
  "address": {
    "street": "Avenida Central",
    "number": "22",
    "postal": "28002",
    "city": "Madrid",
    "province": "Madrid"
  }
}


### 12) LISTAR PROYECTOS
GET {{baseUrl}}/api/project?page=1&limit=10&client={{createClient.response.body.$.data._id}}&active=true&sort=-createdAt
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 13) OBTENER PROYECTO
GET {{baseUrl}}/api/project/{{createProject.response.body.$.data._id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 14) CREAR ALBARÁN MATERIAL
# @name createDeliveryNoteMaterial
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "client": "{{createClient.response.body.$.data._id}}",
  "project": "{{createProject.response.body.$.data._id}}",
  "format": "material",
  "description": "Entrega de cemento",
  "workDate": "2026-04-23",
  "material": "Cemento",
  "quantity": 20,
  "unit": "sacos"
}


### 15) CREAR ALBARÁN HORAS
# @name createDeliveryNoteHours
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "client": "{{createClient.response.body.$.data._id}}",
  "project": "{{createProject.response.body.$.data._id}}",
  "format": "hours",
  "description": "Jornada de albañilería",
  "workDate": "2026-04-23",
  "hours": 8,
  "workers": [
    {
      "name": "Operario 1",
      "hours": 4
    },
    {
      "name": "Operario 2",
      "hours": 4
    }
  ]
}


### 16) LISTAR ALBARANES
GET {{baseUrl}}/api/deliverynote?page=1&limit=10&sort=-workDate
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 17) OBTENER ALBARÁN MATERIAL
GET {{baseUrl}}/api/deliverynote/{{createDeliveryNoteMaterial.response.body.$.data._id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 18) PDF ALBARÁN MATERIAL
GET {{baseUrl}}/api/deliverynote/pdf/{{createDeliveryNoteMaterial.response.body.$.data._id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 19) CREAR ALBARÁN PARA FIRMAR
# @name createDeliveryNoteToSign
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "client": "{{createClient.response.body.$.data._id}}",
  "project": "{{createProject.response.body.$.data._id}}",
  "format": "material",
  "description": "Entrega de yeso",
  "workDate": "2026-04-23",
  "material": "Yeso",
  "quantity": 10,
  "unit": "bolsas"
}


### 20) FIRMAR ALBARÁN
PATCH {{baseUrl}}/api/deliverynote/{{createDeliveryNoteToSign.response.body.$.data._id}}/sign
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: multipart/form-data; boundary=SignBoundary

--SignBoundary
Content-Disposition: form-data; name="signature"; filename="firma.png"
Content-Type: image/png

< {{signaturePath}}
--SignBoundary--


### 21) PDF ALBARÁN FIRMADO
GET {{baseUrl}}/api/deliverynote/pdf/{{createDeliveryNoteToSign.response.body.$.data._id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 22) ARCHIVAR CLIENTE
DELETE {{baseUrl}}/api/client/{{createClient.response.body.$.data._id}}?soft=true
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 23) LISTAR CLIENTES ARCHIVADOS
GET {{baseUrl}}/api/client/archived
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 24) RESTAURAR CLIENTE
PATCH {{baseUrl}}/api/client/{{createClient.response.body.$.data._id}}/restore
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 25) ARCHIVAR PROYECTO
DELETE {{baseUrl}}/api/project/{{createProject.response.body.$.data._id}}?soft=true
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 26) LISTAR PROYECTOS ARCHIVADOS
GET {{baseUrl}}/api/project/archived
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 27) RESTAURAR PROYECTO
PATCH {{baseUrl}}/api/project/{{createProject.response.body.$.data._id}}/restore
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### 28) REFRESH TOKEN
# @name refresh
POST {{baseUrl}}/api/user/refresh
Content-Type: {{json}}

{
  "refreshToken": "{{login.response.body.$.data.refreshToken}}"
}


### 29) CAMBIAR CONTRASEÑA
PUT {{baseUrl}}/api/user/password
Authorization: Bearer {{refresh.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "currentPassword": "{{userPassword}}",
  "newPassword": "{{userNewPassword}}"
}


### 30) LOGIN CON NUEVA CONTRASEÑA
# @name loginNewPassword
POST {{baseUrl}}/api/user/login
Content-Type: {{json}}

{
  "email": "{{register.response.body.$.data.user.email}}",
  "password": "{{userNewPassword}}"
}


### 31) LOGOUT
POST {{baseUrl}}/api/user/logout
Authorization: Bearer {{loginNewPassword.response.body.$.data.accessToken}}


### 32) SOFT DELETE USER
DELETE {{baseUrl}}/api/user?soft=true
Authorization: Bearer {{loginNewPassword.response.body.$.data.accessToken}}


### =========================================================
### CASOS NEGATIVOS
### =========================================================

### REGISTRO INVÁLIDO
POST {{baseUrl}}/api/user/register
Content-Type: {{json}}

{
  "email": "correo-invalido",
  "password": "123"
}


### LOGIN CON PASSWORD INCORRECTA
POST {{baseUrl}}/api/user/login
Content-Type: {{json}}

{
  "email": "{{register.response.body.$.data.user.email}}",
  "password": "PasswordIncorrecta123!"
}


### GET USER SIN TOKEN
GET {{baseUrl}}/api/user


### GET USER CON TOKEN INVÁLIDO
GET {{baseUrl}}/api/user
Authorization: Bearer token_invalido_123


### CLIENTE CON ID INVÁLIDO
GET {{baseUrl}}/api/client/id_invalido
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### CREAR PROYECTO SIN CLIENT
POST {{baseUrl}}/api/project
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "name": "Proyecto sin cliente",
  "projectCode": "PR-ERROR-{{$timestamp}}",
  "email": "error@demo.com",
  "notes": "Debe fallar",
  "active": true
}


### CREAR ALBARÁN CON FORMAT INVÁLIDO
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: {{json}}

{
  "client": "{{createClient.response.body.$.data._id}}",
  "project": "{{createProject.response.body.$.data._id}}",
  "format": "otro",
  "description": "Inválido",
  "workDate": "2026-04-23"
}


### INTENTAR BORRAR ALBARÁN FIRMADO
DELETE {{baseUrl}}/api/deliverynote/{{createDeliveryNoteToSign.response.body.$.data._id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}