###
### =========================================================
### 12) CREAR ALBARÁN DE MATERIAL
### =========================================================
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "client": "{{clientId}}",
  "project": "{{projectId}}",
  "format": "material",
  "description": "Entrega de cemento",
  "workDate": "2026-04-23",
  "material": "Cemento",
  "quantity": 20,
  "unit": "sacos"
}

> {%
  const body = response.body || {};
  client.global.set("deliveryNoteId", body.data?._id || body.deliveryNote?._id || "");
%}

###
### CREAR ALBARÁN DE HORAS
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "client": "{{clientId}}",
  "project": "{{projectId}}",
  "format": "hours",
  "description": "Jornada de albañilería",
  "workDate": "2026-04-23",
  "hours": 8,
  "workers": [
    {
      "name": "Operario 1",
      "hours": 4
    },
    {
      "name": "Operario 2",
      "hours": 4
    }
  ]
}

> {%
  const body = response.body || {};
  client.global.set("deliveryNoteHoursId", body.data?._id || body.deliveryNote?._id || "");
%}

###
### OBTENER ALBARÁN MATERIAL
GET {{baseUrl}}/api/deliverynote/{{deliveryNoteId}}
Authorization: Bearer {{token}}

###
### OBTENER ALBARÁN HORAS
GET {{baseUrl}}/api/deliverynote/{{deliveryNoteHoursId}}
Authorization: Bearer {{token}}

###
### LISTAR ALBARANES
GET {{baseUrl}}/api/deliverynote?page=1&limit=10&sort=-workDate
Authorization: Bearer {{token}}

###
### LISTAR ALBARANES CON FILTROS
GET {{baseUrl}}/api/deliverynote?page=1&limit=10&project={{projectId}}&client={{clientId}}&format=material&signed=false&from=2026-01-01&to=2026-12-31&sort=-workDate
Authorization: Bearer {{token}}

###
### PDF ANTES DE FIRMAR
GET {{baseUrl}}/api/deliverynote/pdf/{{deliveryNoteId}}
Authorization: Bearer {{token}}

###
### BORRAR ALBARÁN NO FIRMADO
DELETE {{baseUrl}}/api/deliverynote/{{deliveryNoteId}}
Authorization: Bearer {{token}}

###
### CREAR OTRO ALBARÁN PARA FIRMAR
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "client": "{{clientId}}",
  "project": "{{projectId}}",
  "format": "material",
  "description": "Entrega de yeso",
  "workDate": "2026-04-23",
  "material": "Yeso",
  "quantity": 10,
  "unit": "bolsas"
}

> {%
  const body = response.body || {};
  client.global.set("deliveryNoteToSignId", body.data?._id || body.deliveryNote?._id || "");
%}

###
### FIRMAR ALBARÁN
PATCH {{baseUrl}}/api/deliverynote/{{deliveryNoteToSignId}}/sign
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=SignBoundary

--SignBoundary
Content-Disposition: form-data; name="signature"; filename="firma.png"
Content-Type: image/png

< {{signaturePath}}
--SignBoundary--

###
### OBTENER ALBARÁN YA FIRMADO
GET {{baseUrl}}/api/deliverynote/{{deliveryNoteToSignId}}
Authorization: Bearer {{token}}

###
### PDF DE ALBARÁN FIRMADO
GET {{baseUrl}}/api/deliverynote/pdf/{{deliveryNoteToSignId}}
Authorization: Bearer {{token}}

###
### INTENTAR BORRAR ALBARÁN FIRMADO (debe fallar)
DELETE {{baseUrl}}/api/deliverynote/{{deliveryNoteToSignId}}
Authorization: Bearer {{token}}

