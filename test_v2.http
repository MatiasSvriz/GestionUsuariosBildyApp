@baseUrl = http://localhost:3000
@json = application/json

###
### =========================================================
### BILDYAPP - TEST E2E MANUAL CON REST CLIENT
### Flujo completo:
### 1) Registro
### 2) Validación email
### 3) Login
### 4) Onboarding usuario
### 5) Onboarding company
### 6) Logo company
### 7) Get user
### 8) Refresh / logout / password
### 9) Clientes
### 10) Proyectos
### 11) Albaranes
### 12) Casos negativos
### 13) Limpieza
### =========================================================

###
### VARIABLES DE APOYO
@userEmail = matias.demo+{{$timestamp}}@test.com
@userPassword = TestPassword123!
@userNewPassword = TestPassword456!
@verificationCode = 123456
@logoPath = ./logo.png
@signaturePath = ./firma.png

###
### HEALTH
GET {{baseUrl}}/health

###
### SWAGGER
GET {{baseUrl}}/api-docs

###
### =========================================================
### 1) REGISTRO DE USUARIO
### =========================================================
POST {{baseUrl}}/api/user/register
Content-Type: {{json}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

> {%
  client.test("Registro devuelve 200/201", function() {
    client.assert(response.status === 200 || response.status === 201, "Status inesperado");
  });

  const body = response.body || {};

  client.global.set("token", body.accessToken || body.token || "");
  client.global.set("refreshToken", body.refreshToken || "");
  client.global.set("registeredEmail", body.data?.email || body.user?.email || "{{userEmail}}");

  // Por si tu backend devuelve user dentro de data o user
  client.global.set("userId", body.data?._id || body.user?._id || "");

  // Si tu backend expone el código en desarrollo, lo aprovechamos
  if (body.data?.verificationCode) client.global.set("verificationCode", body.data.verificationCode);
  if (body.user?.verificationCode) client.global.set("verificationCode", body.user.verificationCode);
%}

###
### REGISTRO DUPLICADO (debe fallar)
POST {{baseUrl}}/api/user/register
Content-Type: {{json}}

{
  "email": "{{registeredEmail}}",
  "password": "{{userPassword}}"
}

###
### REGISTRO INVÁLIDO (debe fallar)
POST {{baseUrl}}/api/user/register
Content-Type: {{json}}

{
  "email": "correo-invalido",
  "password": "123"
}

###
### =========================================================
### 2) VALIDACIÓN DE EMAIL
### IMPORTANTE:
### - Si tu API NO devuelve verificationCode en registro,
###   saca el código de MongoDB/Compass y pégalo en @verificationCode
### =========================================================
PUT {{baseUrl}}/api/user/validation
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "code": "{{verificationCode}}"
}

###
### VALIDACIÓN CON CÓDIGO INCORRECTO (debe fallar)
PUT {{baseUrl}}/api/user/validation
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "code": "000000"
}

###
### =========================================================
### 3) LOGIN
### OJO: aquí va la contraseña REAL, no el hash bcrypt
### =========================================================
POST {{baseUrl}}/api/user/login
Content-Type: {{json}}

{
  "email": "{{registeredEmail}}",
  "password": "{{userPassword}}"
}

> {%
  client.test("Login correcto", function() {
    client.assert(response.status === 200, "El login debería devolver 200");
  });

  const body = response.body || {};
  client.global.set("token", body.accessToken || body.token || "");
  client.global.set("refreshToken", body.refreshToken || "");
  client.global.set("userId", body.data?._id || body.user?._id || client.global.get("userId") || "");
%}

###
### LOGIN CON PASSWORD INCORRECTA (debe fallar)
POST {{baseUrl}}/api/user/login
Content-Type: {{json}}

{
  "email": "{{registeredEmail}}",
  "password": "PasswordIncorrecta123!"
}

###
### LOGIN CON EMAIL NO EXISTENTE (debe fallar)
POST {{baseUrl}}/api/user/login
Content-Type: {{json}}

{
  "email": "no.existe.{{$timestamp}}@test.com",
  "password": "TestPassword123!"
}

