###
### =========================================================
### 6) LOGO DE COMPANY
### =========================================================
PATCH {{baseUrl}}/api/user/logo
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=LogoBoundary

--LogoBoundary
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

< {{logoPath}}
--LogoBoundary--

###
### =========================================================
### 7) REFRESH TOKEN
### =========================================================
POST {{baseUrl}}/api/user/refresh
Content-Type: {{json}}

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  const body = response.body || {};
  client.global.set("token", body.accessToken || body.token || client.global.get("token"));
  client.global.set("refreshToken", body.refreshToken || client.global.get("refreshToken"));
%}

###
### REFRESH INVÁLIDO (debe fallar)
POST {{baseUrl}}/api/user/refresh
Content-Type: {{json}}

{
  "refreshToken": "refresh_token_invalido"
}

