  "name": "Matias",
  "lastName": "Demo Tester",
  "nif": "12345678Z",
  "address": {
    "street": "Calle Falsa",
    "number": "123",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}

###
### GET USUARIO AUTENTICADO (antes de company)
GET {{baseUrl}}/api/user
Authorization: Bearer {{token}}

###
### =========================================================
### 5) ONBOARDING - COMPANY
### =========================================================
PATCH {{baseUrl}}/api/user/company
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Bildy Demo Company",
  "cif": "B12345678",
  "isFreelance": false,
  "address": {
    "street": "Avenida Empresa",
    "number": "22",
    "postal": "28002",
    "city": "Madrid",
    "province": "Madrid"
